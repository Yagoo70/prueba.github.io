name: Mi Primer Workflow

# Cuando se ejecuta
on:
  push:        # Se ejecuta cada vez que haces push
    branches: [ "main" ]
  workflow_dispatch:  # Permite ejecutarlo manualmente desde Actions

jobs:
  build:
    runs-on: ubuntu-latest   # Servidor donde se ejecuta

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Saludo
        run: echo "¡Hola desde GitHub Actions!"
